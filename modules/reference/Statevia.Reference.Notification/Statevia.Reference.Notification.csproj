<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Statevia.Reference.Notification</RootNamespace>
    <AssemblyName>Statevia.Reference.Notification</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ReferenceModuleId>statevia.action.reference.notification</ReferenceModuleId>
    <DefaultTenantModulesDir>$(MSBuildThisFileDirectory)..\..\..\modules\default\$(ReferenceModuleId)\</DefaultTenantModulesDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Statevia.Reference.Notification.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\actions\Statevia.Core.Actions.Abstractions\Statevia.Core.Actions.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\core\engine\Statevia.Core.Engine\Statevia.Core.Engine.csproj" />
  </ItemGroup>

  <Target Name="CopyToDefaultTenantModules" AfterTargets="Build">
    <MakeDir Directories="$(DefaultTenantModulesDir)" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(DefaultTenantModulesDir)$(ReferenceModuleId).dll"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
