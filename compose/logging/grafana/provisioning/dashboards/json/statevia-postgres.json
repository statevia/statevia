                "rawQuery": true,
                "rawSql": "SELECT w.kind, count(*)::bigint AS count\nFROM execution_work_items w\nINNER JOIN executions e ON e.execution_id = w.execution_id\nWHERE e.tenant_id = '$tenant'::uuid\nGROUP BY w.kind\nORDER BY w.kind;",
