                "editorMode": "code",
                "format": "table",
                "rawQuery": true,
                "rawSql": "SELECT\n  d.display_id,\n  e.status,\n  e.started_at,\n  e.updated_at,\n  e.cancel_requested,\n  e.restart_lost\nFROM executions e\nLEFT JOIN display_ids d\n  ON d.resource_id = e.execution_id AND d.kind = 'execution'\nWHERE e.tenant_id = '$tenant'::uuid\n  AND $__timeFilter(e.updated_at)\nORDER BY e.updated_at DESC\nLIMIT 100;",
                "refId": "A"
            }],
            "title": "Recent executions",
