                "rawQuery": true,
                "rawSql": "SELECT\n  $__timeGroupAlias(updated_at,$__interval),\n  status AS metric,\n  count(*)::bigint AS value\nFROM executions\nWHERE $__timeFilter(updated_at)\n  AND tenant_id = '$tenant'::uuid\nGROUP BY 1, status\nORDER BY 1;",
