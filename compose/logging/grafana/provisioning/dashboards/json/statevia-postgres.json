                "rawQuery": true,
                "rawSql": "SELECT ew.wait_kind, count(*)::bigint AS count\nFROM execution_waits ew\nINNER JOIN executions e ON e.execution_id = ew.execution_id\nWHERE e.tenant_id = '$tenant'::uuid\nGROUP BY ew.wait_kind\nORDER BY ew.wait_kind;",
                "refId": "A"
