# Docker Compose ローカル開発用。
# リポジトリルートで: cp .env.example .env
# .env はコミットしない（.gitignore）。

POSTGRES_USER=statevia
POSTGRES_PASSWORD=statevia
POSTGRES_DB=statevia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 任意: Scheduler / Worker 分離は compose override を使う（API 内 Off とコンテナ起動が同時）。
# docker compose -f docker-compose.yml -f docker-compose.split-runtime.yml up -d

# 任意: 想定外例外のエラー監視。未設定なら SDK は動かない。受信側は製品 compose に含めない。
# SENTRY_DSN=
