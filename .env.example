# Docker Compose ローカル開発用。
# リポジトリルートで: cp .env.example .env
# .env はコミットしない（.gitignore）。
#
# 有効なのは、compose が ${名前} で参照する項目だけ。
# コメント行は渡らない。未設定時の値は各 compose の ${名前:-既定} に従う。

# --- PostgreSQL（必須。既定値なし）---
# docker-compose.yml の postgres / service-api、分離時の scheduler / worker、logging の補助 DB。
POSTGRES_USER=statevia
POSTGRES_PASSWORD=statevia
POSTGRES_DB=statevia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Worker 分離（docker-compose.split-runtime.yml）---
# docker compose -f docker-compose.yml -f docker-compose.split-runtime.yml up -d
# MaxConcurrency は Start / Resume の同時件数。未設定時 16。範囲 1〜64。
# API 内 Worker（分離しない compose）はこの変数を読まず、コード既定の 1 のまま。
#STATEVIA_WORKER_MAX_CONCURRENCY=16

# Cancel 独立ループの同時件数。未設定時 1。範囲 1〜8。
#STATEVIA_WORKER_CANCEL_CONCURRENCY=1

# --- エラー監視（docker-compose.yml / split-runtime.yml の worker）---
# 未設定・空なら SDK は動かない。受信側は製品 compose に含めない。
# コンテナから送るのでホストは host.docker.internal。ホスト 9000 は SonarQube 占有。
#SENTRY_DSN=http://<public-key>@host.docker.internal:9090/<project-id>

# --- ログ収集（docker-compose.logging.yml / docker-compose.logging-split.yml）---
# fluentd ドライバの宛先。未設定時 localhost:24224。デーモンから届かないときは host.docker.internal:24224。
#STATEVIA_FLUENTD_ADDRESS=localhost:24224

# --- compose 内で固定している主なコンテナ設定（このファイルでは渡さない）---
# 変えるときは compose の environment を編集する。名前だけ控える。
#
# service-api:
#   ASPNETCORE_ENVIRONMENT=Development
#   ASPNETCORE_URLS=http://+:8080
#   DATABASE_URL は上の POSTGRES_* から組み立てる
#   Statevia__ActionHost__BaseUrl=http://action-host:5001
#   Statevia__Runtime__EnableInProcessWorker=true
#   Statevia__Runtime__EnableInProcessDelayWaitScheduler=true
#   Statevia__Runtime__EnableInProcessOwnershipRecovery=true
#   Statevia__Runtime__EnableInProcessScheduleDispatcher=true
#   分離 override は上の EnableInProcess* を false にする
#   ブラウザから API へ直叩きするときだけ Statevia__Cors__AllowedOrigins__0
#
# action-host:
#   ASPNETCORE_ENVIRONMENT=Development
#   ASPNETCORE_URLS=http://+:5001
#   STATEVIA_MODULES_PATH=/app/modules
#   次に空白以外の値があると Action Host は起動しない:
#   DATABASE_URL
#   STATEVIA_SECRETS_KEY
#   Statevia__Secrets__EncryptionKey
#   STATEVIA_SMTP_HOST / STATEVIA_SMTP_PORT / STATEVIA_SMTP_USER / STATEVIA_SMTP_PASSWORD / STATEVIA_SMTP_FROM
#   STATEVIA_NOTIFICATION_SMTP_SOURCE
#   STATEVIA_BOOTSTRAP_PASSWORD
#   Auth__Jwt__SigningKey
#
# scheduler / worker（分離時）:
#   DOTNET_ENVIRONMENT=Development
#   ASPNETCORE_ENVIRONMENT=Development
#   worker の Statevia__ActionHost__BaseUrl=http://action-host:5001
#   Statevia__Runtime__Worker__NoProgressTimeout=00:10:00
#   Statevia__Runtime__Worker__MaxAttempts はコード既定 20（compose では未設定）
#
# ui-studio:
#   SERVICE_API_INTERNAL_BASE=http://service-api:8080
#   開発トークン（production では無視）: SERVICE_API_AUTH_TOKEN / NEXT_PUBLIC_AUTH_TOKEN
#
# ホストで API を直接起動するとき（compose の外）:
#   STATEVIA_ENABLE_API_DOCS=true
#   STATEVIA_LOG_HTTP_BODIES
#   STATEVIA_SECRETS_KEY（Production / Staging の Service API と専用 Worker は起動必須）
#   Auth__Jwt__SigningKey（Service API のみ。Production / Staging は開発既定値を拒否）
#   STATEVIA_API_KEY（CLI の modules reload など）
#   Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Information
