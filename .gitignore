# statevia リポジトリ用 .gitignore
# 生成物・個人設定・秘密情報を除外する。CI / 品質ゲートの正本はコンポーネント別 sln。

# --- ビルド / 発行 ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
artifacts/
*.binlog
[Bb]uild[Ll]og.*

# --- NuGet ---
*.nupkg
*.snupkg

# --- テスト / カバレッジ ---
[Tt]est[Rr]esult*/
coverage/

# --- IDE / エディタ ---
# Visual Studio のユーザーローカル状態
.vs/
*.user
*.suo
# Sdk.Web を開くと Properties/launchSettings.json が自動生成される。
# 起動 URL の正本は docs / docker / `dotnet run --no-launch-profile`。
**/Properties/launchSettings.json
# Cursor / VS Code: 個人設定は除外。チーム共有は settings.json のみ。
.vscode/*
!.vscode/settings.json

# --- エージェント / ローカルツール ---
.cursor/
.cursorrules
.claude/
# Serena 作業ファイルは除外。ルートの C# 横断 project.yml だけ共有する。
**/.serena/
!/.serena/
/.serena/*
!/.serena/project.yml
.mcp.json
.playwright-mcp/

# --- Spec ---
# templates と steering のみ共有。specs / archive / reject はローカル。
.spec/*
!.spec/templates/
!.spec/templates/**
!.spec/steering/
!.spec/steering/**

# --- SonarQube ---
# カバレッジ XML とスキャナ作業ディレクトリは生成物。スクリプト・README・compose は共有。
.sonarqube/
.sonarlint/
.scannerwork/
sonar/*
!sonar/*.ps1
!sonar/README.md
!sonar/docker-compose.yaml

# --- 秘密情報 / ローカルデータ ---
.env
.local/

# --- OS / 一時ファイル ---
.DS_Store
Thumbs.db
~$*
*~

# --- リポジトリ固有の生成物 ---
docs/out/
# 容量計測の生結果（公開しない）
tools/capacity/results/
# ビルドで copy するリファレンス Module DLL（実行時配置）
modules/default/statevia.action.reference.*/
