{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "EventDelivery": {
        "Retry": {
            "MaxAttempts": 3,
            "BaseDelayMs": 50,
            "MaxDelayMs": 2000,
            "Jitter": true,
            "MaxTotalBackoffMs": 8000
        }
    },
    "Notification": {
        "SmtpSettingsSource": "Environment",
        "Smtp": {
            "Port": 587
        }
    },
    "Statevia": {
        "ExecutionPolicy": {
            "DeploymentProfile": null
        },
        "ActionHost": {
            "BaseUrl": "http://localhost:5001"
        }
    }
}