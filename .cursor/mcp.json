{
  "mcpServers": {
    "sonarqube": {
      "url": "http://127.0.0.1:9124/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "statevia"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {}
    },
    "playwright-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ],
      "env": {}
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://statevia:${env:STATEVIA}@localhost:5432/statevia"
      ]
    },
    "serena-csharp": {
       "type": "http",
      "url": "http://127.0.0.1:9121/mcp"
    },
    "serena-ui": {
      "type": "http",
      "url": "http://127.0.0.1:9122/mcp"
    },
    "melore": {
      "command": "${workspaceFolder}/../Melore/artifacts/melore-mcp/melore-mcp.exe",
      "args": [
        "--config",
        "${workspaceFolder}/../Melore/melore.json"
      ]
    }
  }
}
