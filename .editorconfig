root = true

# =============================================================================
# SonarAnalyzer（Cursor が読める重大度）
# =============================================================================

[*.{cs,vb}]

# Cursor は Error と Warning だけを読む。Sonar のコードスメルを Info のままにすると、
# IDE の波線には出てもエージェントの診断には届かない。
# カテゴリ名は Sonar 専用で、CA 系とは重ならない。
# コマンドラインの dotnet build では Directory.Build.targets がこの Analyzer を外し、Warning 0 を維持する。
# Scanner 実行中は Scanner が差し替える Analyzer に任せる。
dotnet_analyzer_diagnostic.category-Blocker Bug.severity = warning
dotnet_analyzer_diagnostic.category-Blocker Code Smell.severity = warning
dotnet_analyzer_diagnostic.category-Blocker Vulnerability.severity = warning
dotnet_analyzer_diagnostic.category-Critical Bug.severity = warning
dotnet_analyzer_diagnostic.category-Critical Code Smell.severity = warning
dotnet_analyzer_diagnostic.category-Critical Vulnerability.severity = warning
dotnet_analyzer_diagnostic.category-Info Code Smell.severity = warning
dotnet_analyzer_diagnostic.category-Major Bug.severity = warning
dotnet_analyzer_diagnostic.category-Major Code Smell.severity = warning
dotnet_analyzer_diagnostic.category-Major Vulnerability.severity = warning
dotnet_analyzer_diagnostic.category-Minor Bug.severity = warning
dotnet_analyzer_diagnostic.category-Minor Code Smell.severity = warning
dotnet_analyzer_diagnostic.category-Minor Vulnerability.severity = warning

# =============================================================================
# core/engine/Statevia.Core.Engine.Tests
# =============================================================================

[core/engine/Statevia.Core.Engine.Tests/**/*.cs]

# CA1515: インスタンス化されない型は internal にせよ（アセンブリ API 表面を狭める）。
# 除外理由: xUnit は public なテストクラスを反射で検出する。internal 化すると xUnit1000 でビルド失敗する。
#            `dotnet format` 実行時に CA1515 がテスト型へ掛かり、意図せず internal 化されるのを防ぐ。
dotnet_diagnostic.CA1515.severity = none

# CA1707: メンバー名からアンダースコアを削除せよ（PascalCase / camelCase 規約）。
# 除外理由: テストメソッド名を Method_State_Expected 形式（アンダースコア区切り）で統一している。
#            Sonar external_roslyn:CA1707 のノイズ低減にも寄与する。
dotnet_diagnostic.CA1707.severity = none

# CA2000: スコープを抜ける前に IDisposable を破棄せよ。
# 除外理由: 短い統合テストでは Engine / ハーネスを毎回 Dispose しないパターンが多く、
#            テスト終了時のプロセス終了に任せる運用としている。
dotnet_diagnostic.CA2000.severity = none

# CA2007: await に ConfigureAwait を付けよ（ライブラリコード向けの同期コンテキスト回避）。
# 除外理由: xUnit1030 に合わせテストでは ConfigureAwait(false) を付けない方針。
#            CA2007（付けろ）と方針が両立しない。
dotnet_diagnostic.CA2007.severity = none

# CA1861: 繰り返し呼ぶメソッドには定数配列引数より static readonly フィールドを使え。
# 除外理由: テストの Assert やフィクスチャでインライン配列リテラルを使う方が読みやすい。
#            static readonly への抽出はボイラープレートが増えるだけで実益が小さい。
dotnet_diagnostic.CA1861.severity = none

# CA1848: LoggerMessage を使え。
# 除外理由: テスト内のユーザーログ再現は ILogger 拡張の 1 行呼び出しで十分。本番コードの LoggerMessage 方針は変えない。
dotnet_diagnostic.CA1848.severity = none

# CA1859: 具象型で戻り値・ローカルを宣言せよ。
# 除外理由: テストヘルパーはインターフェース戻り値の方が差し替えやすい（Api.Tests と同じ）。
dotnet_diagnostic.CA1859.severity = none

# =============================================================================
# service/cli/Statevia.Service.Cli.Tests
# =============================================================================

[service/cli/Statevia.Service.Cli.Tests/**/*.cs]

# CA1515: インスタンス化されない型は internal にせよ。
# 除外理由: Engine.Tests と同様、xUnit の public テストクラス要件と `dotnet format` による誤 internal 化を防ぐ。
dotnet_diagnostic.CA1515.severity = none

# CA1707: メンバー名からアンダースコアを削除せよ。
# 除外理由: Engine.Tests と同様、テスト命名規約（アンダースコア区切り）を維持する。
dotnet_diagnostic.CA1707.severity = none

# CA2000: スコープを抜ける前に IDisposable を破棄せよ。
# 除外理由: Engine.Tests と同様、短いテストでの Dispose 省略パターンを許容する。
dotnet_diagnostic.CA2000.severity = none

# CA2007: await に ConfigureAwait を付けよ。
# 除外理由: Engine.Tests と同様、xUnit1030 方針（ConfigureAwait なし）と両立しない。
dotnet_diagnostic.CA2007.severity = none

# CA1861: 定数配列引数より static readonly フィールドを使え。
# 除外理由: Engine.Tests と同様、インライン配列リテラルの可読性を優先する。
dotnet_diagnostic.CA1861.severity = none

# =============================================================================
# service/api/Statevia.Service.Api/Migrations
# =============================================================================

[service/api/Statevia.Service.Api/Migrations/*.cs]

# CS1591: 公開型の XML ドキュメントがない。
# 除外理由: EF 生成マイグレーション。手編集・XML 付与の対象外。
dotnet_diagnostic.CS1591.severity = none

# CA1515: アセンブリ API を internal にせよ（インスタンス化されない型は internal に）。
# 除外理由: EF マイグレーションクラスは public 必須。アプリ外への参照面ではない。
dotnet_diagnostic.CA1515.severity = none

# generated_code / dotnet_analyzer_diagnostic: IDE・ビルドの Roslyn 波線を抑止。
# 除外理由: Migrations は品質リファクタ対象外（スキーマ定義のスナップショット）。
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# S1192: 同一リテラル文字列の定数化を推奨（Sonar Standalone 向け）。
# 除外理由: EF マイグレーションの列型・インデックス定義は生成物に近く、定数抽出の実益がない。
# 補足: Sonar Connected mode では .editorconfig が無視されることがある。Migrations/SonarScopeSuppressions.cs を参照。
dotnet_diagnostic.S1192.severity = none

# =============================================================================
# service/api/Statevia.Service.Api — HTTP / DI 公開面（CA1515）
# =============================================================================

[service/api/Statevia.Service.Api/Controllers/*.cs]

# CA1515: アセンブリ API を internal にせよ（インスタンス化されない型は internal に）。
# 除外理由: ASP.NET Core が Controller を public で発見する。internal 化するとルーティング登録されない。
dotnet_diagnostic.CA1515.severity = none

[service/api/Statevia.Service.Api/Contracts/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: JSON 契約 DTO・例外型は HTTP レスポンス／フィルタの公開面として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[service/api/Statevia.Service.Api/Abstractions/Services/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Controller コンストラクタ注入のサービス IF は public 必須（同一アセンブリの DI 境界）。
dotnet_diagnostic.CA1515.severity = none

[service/api/Statevia.Service.Api/Services/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Controller から直接注入する SSE 等のサービスは public のままとする。
dotnet_diagnostic.CA1515.severity = none

# =============================================================================
# service/api/Statevia.Service.Api — 個別ファイル
# =============================================================================

[service/api/Statevia.Service.Api/Hosting/**/*.cs]

# ASP0015: ヘッダ辞書の推奨 API を使え。
# 除外理由: W3C traceparent や X-Trace-Id 等のカスタムヘッダは文字列キー指定が契約どおり。
dotnet_diagnostic.ASP0015.severity = none

[service/api/Statevia.Service.Api/Abstractions/Services/IExecutionProjectionUpdateQueue.cs]

# CA1711: 識別子は接尾辞に型名を使うな（Queue 等の汎用語を避けよ）。
# 除外理由: 既存の DI 契約名。Queue サフィックスへのリネームは公開面の破壊変更となる。
dotnet_diagnostic.CA1711.severity = none

# =============================================================================
# service/api/Statevia.Service.Api.Tests
# =============================================================================

[service/api/Statevia.Service.Api.Tests/**/*.cs]

# CA1515: インスタンス化されない型は internal にせよ（アセンブリ API 表面を狭める）。
# 除外理由: xUnit は public なテストクラスを反射で検出する。internal 化すると xUnit1000 でビルド失敗する。
#            `dotnet format` 実行時に CA1515 がテスト型へ掛かり、意図せず internal 化されるのを防ぐ。
dotnet_diagnostic.CA1515.severity = none

# CA1707: メンバー名からアンダースコアを削除せよ（PascalCase / camelCase 規約）。
# 除外理由: テストメソッド名を Method_State_Expected 形式（アンダースコア区切り）で統一している。
#            Sonar external_roslyn:CA1707 のノイズ低減にも寄与する。
dotnet_diagnostic.CA1707.severity = none

# CA2000: スコープを抜ける前に IDisposable を破棄せよ。
# 除外理由: 短い統合テストでは DbContext / ハーネスを毎回 Dispose しないパターンが多く、
#            テスト終了時のプロセス終了に任せる運用としている。
dotnet_diagnostic.CA2000.severity = none

# CA2007: await に ConfigureAwait を付けよ（ライブラリコード向けの同期コンテキスト回避）。
# 除外理由: xUnit1030 に合わせテストでは ConfigureAwait(false) を付けない方針。
#            CA2007（付けろ）と方針が両立しない。
dotnet_diagnostic.CA2007.severity = none

# CA1861: 繰り返し呼ぶメソッドには定数配列引数より static readonly フィールドを使え。
# 除外理由: テストの Assert やフィクスチャでインライン配列リテラルを使う方が読みやすい。
#            static readonly への抽出はボイラープレートが増えるだけで実益が小さい。
dotnet_diagnostic.CA1861.severity = none

# CA1307: 文字列比較に StringComparison を指定せよ。
# 除外理由: xUnit の Assert.Contains / DoesNotContain はテスト意図の可読性を優先し、
#            既定の序数比較で十分。Sonar external_roslyn:CA1307 のノイズ低減にも寄与する。
dotnet_diagnostic.CA1307.severity = none

# ASP0015: ヘッダ辞書の推奨 API を使え。
# 除外理由: テストの DefaultHttpContext では文字列キー指定の方が意図が明確。
dotnet_diagnostic.ASP0015.severity = none

# CA1859: 具象型で戻り値・ローカルを宣言せよ。
# 除外理由: テストのヘルパーはインターフェース戻り値の方が差し替えやすい。
dotnet_diagnostic.CA1859.severity = none

# CA1869: JsonSerializerOptions をキャッシュせよ。
# 除外理由: 単発テストでのオプション生成は可読性を優先する。
dotnet_diagnostic.CA1869.severity = none

# CA2201: 十分に特定された例外型を使え。
# 除外理由: フィルタの汎用 Exception 経路を意図的に検証する。
dotnet_diagnostic.CA2201.severity = none

# =============================================================================
# service/cli/Statevia.Service.Cli
# =============================================================================

[service/cli/Statevia.Service.Cli/**/*.cs]

# CA1303: ローカライズ可能なパラメーターにリテラル文字列を渡すな（リソースファイル経由にせよ）。
# 除外理由: 開発者向け CLI ツールであり、多言語リソース化の対象外。Usage / エラーメッセージは英語固定で十分。
dotnet_diagnostic.CA1303.severity = none
