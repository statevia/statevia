<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Statevia.Tools.Capacity</RootNamespace>
    <AssemblyName>Statevia.Tools.Capacity</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
    <!-- 計測用のツールで製品コードではないため、Guid.NewGuid を許す（build/BannedGuidNewGuid.props の対象外）。 -->
    <StateviaAllowGuidNewGuid>true</StateviaAllowGuidNewGuid>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Statevia.Tools.Capacity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Definitions\*.yaml" />
  </ItemGroup>

</Project>
