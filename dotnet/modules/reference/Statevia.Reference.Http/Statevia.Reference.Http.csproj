<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Statevia.Reference.Http</RootNamespace>
    <AssemblyName>Statevia.Reference.Http</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML ドキュメントの欠落（internal を含む）をビルドの警告にする（build/Documentation.targets）。 -->
    <StateviaDocumentationRulesEnabled>true</StateviaDocumentationRulesEnabled>
    <ReferenceModuleId>statevia.action.reference.http</ReferenceModuleId>
    <DefaultTenantModulesDir>$(StateviaModulesOutputRoot)default\$(ReferenceModuleId)\</DefaultTenantModulesDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Statevia.Reference.Http.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\actions\Statevia.Core.Actions.Abstractions\Statevia.Core.Actions.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\core\engine\Statevia.Core.Engine\Statevia.Core.Engine.csproj" />
  </ItemGroup>

  <Target Name="CopyToDefaultTenantModules" AfterTargets="Build">
    <MakeDir Directories="$(DefaultTenantModulesDir)" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(DefaultTenantModulesDir)$(ReferenceModuleId).dll"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
