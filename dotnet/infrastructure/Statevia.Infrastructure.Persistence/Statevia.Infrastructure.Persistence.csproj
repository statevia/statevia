<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Statevia.Infrastructure.Persistence</RootNamespace>
    <AssemblyName>Statevia.Infrastructure.Persistence</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- SonarScanner for .NET: SDK 形式は既定 GUID を持たない。sln 外の ProjectReference で 00000000 重複警告になるのを防ぐ。 -->
    <ProjectGuid>{0F99D271-543E-4FC1-B2AE-1D9F21CEB711}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Statevia.Core.Application.Contracts.Persistence" />
    <Using Include="Statevia.Core.Application.Contracts.Security" />
    <Using Include="Statevia.Core.Application.Contracts.Services" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Statevia.Service.Api" />
    <InternalsVisibleTo Include="Statevia.Service.Api.Tests" />
    <InternalsVisibleTo Include="Statevia.Service.Api.Bootstrap" />
    <InternalsVisibleTo Include="Statevia.Service.Api.Scenario.Tests" />
    <InternalsVisibleTo Include="Statevia.Infrastructure.Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Npgsql の EF プロバイダー経由では古い Relational が選ばれ、EF Core と版が混ざる。参照先にも同じ版が届くよう直接参照する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\..\core\application\Statevia.Core.Application.Contracts\Statevia.Core.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
