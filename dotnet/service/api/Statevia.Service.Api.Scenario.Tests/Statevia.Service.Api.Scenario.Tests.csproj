<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA2007: ASP.NET Core テストホストでは SynchronizationContext が掛からないためノイズ。 -->
    <!-- CA1707: xUnit のテストメソッド名にアンダースコアを使う慣例のため。 -->
    <!-- CA1515: テストアセンブリ内の型は xUnit / Collection 公開のため public を維持する。 -->
    <!-- CA1711: CollectionDefinition の型名が Collection で終わるのは xUnit 慣例。 -->
    <!-- CA1031: Docker 未起動時は任意例外を Skip に落とす設計のため。 -->
    <NoWarn>$(NoWarn);CA2007;CA1707;CA1515;CA1711;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Statevia.Core.Application.Contracts.Security" />
    <Using Include="Statevia.Core.Application.Contracts.Persistence" />
    <Using Include="Statevia.Infrastructure.Persistence" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Statevia.Service.Api\Statevia.Service.Api.csproj" />
    <ProjectReference Include="..\Statevia.Service.Api.Bootstrap\Statevia.Service.Api.Bootstrap.csproj" />
    <ProjectReference Include="..\..\..\core\application\Statevia.Core.Application.Contracts\Statevia.Core.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\infrastructure\Statevia.Infrastructure.Persistence\Statevia.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\..\infrastructure\Statevia.Infrastructure.Security\Statevia.Infrastructure.Security.csproj" />
  </ItemGroup>

</Project>
