root = false

# =============================================================================
# HTTP / DI 公開面（CA1515）
# CA1515 の ** はサブディレクトリ前提の解釈で直下 *.cs にマッチしない環境があるため *.cs を使用。
# =============================================================================

[Contracts/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: JSON 契約 DTO・例外型は HTTP レスポンス／フィルタの公開面として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[Controllers/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: ASP.NET Core が Controller を public で発見する。internal 化するとルーティング登録されない。
dotnet_diagnostic.CA1515.severity = none

[Abstractions/Services/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Controller コンストラクタ注入のサービス IF は public 必須（同一アセンブリの DI 境界）。
dotnet_diagnostic.CA1515.severity = none

[Abstractions/Security/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: AuthController / ミドルウェアの DI 境界として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[Contracts/Auth/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: 認証 API の JSON 契約 DTO は HTTP 公開面として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[Contracts/Admin/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: 管理者 API の JSON 契約 DTO は HTTP 公開面として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[Contracts/Actions/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Action Schema API の JSON 契約 DTO は HTTP 公開面として public を維持する。
dotnet_diagnostic.CA1515.severity = none

[Application/Security/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: 同一アセンブリ内のセキュリティドメイン型。public はテスト InternalsVisibleTo で十分。
dotnet_diagnostic.CA1515.severity = none

[Configuration/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Options バインド用。アセンブリ外参照なし。
dotnet_diagnostic.CA1515.severity = none

[Infrastructure/Security/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Worker スコープ入口は同一アセンブリ内利用。
dotnet_diagnostic.CA1515.severity = none

[Services/*.cs]

# CA1515: アセンブリ API を internal にせよ。
# 除外理由: Controller から直接注入する SSE 等のサービスは public のままとする。
dotnet_diagnostic.CA1515.severity = none

# =============================================================================
# 個別ファイル
# =============================================================================

[Hosting/OpenApi/*.cs]

# S2325: インスタンスデータ未使用のメソッドは static にせよ。
# 除外理由: Swashbuckle IOperationFilter.Apply はインスタンスメソッドが契約上必須。処理本体は static ヘルパーへ分離する。
dotnet_diagnostic.S2325.severity = none

# CA1822: アクセスしていないメンバーは static にせよ（Roslyn。IOperationFilter と同趣旨）。
dotnet_diagnostic.CA1822.severity = none

[Abstractions/Services/IExecutionProjectionUpdateQueue.cs]

# CA1711: 識別子は接尾辞に型名を使うな（Queue 等の汎用語を避けよ）。
# 除外理由: 既存の DI 契約名。Queue サフィックスへのリネームは公開面の破壊変更となる。
dotnet_diagnostic.CA1711.severity = none
