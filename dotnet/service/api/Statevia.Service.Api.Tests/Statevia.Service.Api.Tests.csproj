<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Sentry" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Statevia.Core.Actions.Abstractions.Modules" />
    <Using Include="Statevia.Core.Application.Contracts" />
    <Using Include="Statevia.Core.Application.Contracts.Persistence" />
    <Using Include="Statevia.Core.Application.Contracts.Security" />
    <Using Include="Statevia.Core.Application.Contracts.Services" />
    <Using Include="Statevia.Service.Api.Persistence" />
    <Using Include="Statevia.Infrastructure.Security" />
    <Using Include="Statevia.Infrastructure.Security.Configuration" />
    <Using Include="Statevia.Infrastructure.Notification" />
    <Using Include="Statevia.Infrastructure.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\engine\Statevia.Core.Engine\Statevia.Core.Engine.csproj" />
    <ProjectReference Include="..\..\..\core\application\Statevia.Core.Application.Contracts\Statevia.Core.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\core\application\Statevia.Core.Application\Statevia.Core.Application.csproj" />
    <ProjectReference Include="..\..\..\infrastructure\Statevia.Infrastructure.Common\Statevia.Infrastructure.Common.csproj" />
    <ProjectReference Include="..\Statevia.Service.Api\Statevia.Service.Api.csproj" />
    <ProjectReference Include="..\Statevia.Service.Api.Bootstrap\Statevia.Service.Api.Bootstrap.csproj" />
    <ProjectReference Include="..\..\action-host\Statevia.Service.ActionHost\Statevia.Service.ActionHost.csproj" Aliases="ActionHost" />
    <ProjectReference Include="..\..\..\modules\reference\Statevia.Reference.Http\Statevia.Reference.Http.csproj" Aliases="HttpReference" />
    <ProjectReference Include="Fixtures\TestActionModule\TestActionModule.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <Target Name="CopyTestActionModuleFixture" AfterTargets="Build">
    <PropertyGroup>
      <TestActionModuleOutput>$(MSBuildThisFileDirectory)Fixtures\TestActionModule\bin\$(Configuration)\$(TargetFramework)\</TestActionModuleOutput>
    </PropertyGroup>
    <ItemGroup>
      <TestActionModuleCopy Include="$(TestActionModuleOutput)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TestActionModuleCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
