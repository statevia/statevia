<Project>
  <PropertyGroup>
    <!-- action-host スキャン以外では Sonar の protobuf を出さない。 -->
    <StateviaSonarComponent>action-host</StateviaSonarComponent>
  </PropertyGroup>
  <!-- 共通設定。StateviaSonarComponent を設定した後に読み込む。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
