<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Statevia.Service.ActionHost\Statevia.Service.ActionHost.csproj" />
    <ProjectReference Include="..\..\..\tests\Fixtures\ActionModules\TestActionModule\TestActionModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\tests\Fixtures\ActionModules\MalformedActionModule\MalformedActionModule.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\tests\Fixtures\ActionModules\PrivateCtorActionModule\PrivateCtorActionModule.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyActionHostTestModuleFixtures" AfterTargets="Build">
    <PropertyGroup>
      <TestActionModuleOutput>$(MSBuildThisFileDirectory)..\..\..\tests\Fixtures\ActionModules\TestActionModule\bin\$(Configuration)\$(TargetFramework)\</TestActionModuleOutput>
      <MalformedActionModuleOutput>$(MSBuildThisFileDirectory)..\..\..\tests\Fixtures\ActionModules\MalformedActionModule\bin\$(Configuration)\$(TargetFramework)\</MalformedActionModuleOutput>
      <PrivateCtorActionModuleOutput>$(MSBuildThisFileDirectory)..\..\..\tests\Fixtures\ActionModules\PrivateCtorActionModule\bin\$(Configuration)\$(TargetFramework)\</PrivateCtorActionModuleOutput>
    </PropertyGroup>
    <ItemGroup>
      <ActionHostFixtureCopy Include="$(TestActionModuleOutput)*.dll" />
      <ActionHostFixtureCopy Include="$(MalformedActionModuleOutput)*.dll" />
      <ActionHostFixtureCopy Include="$(PrivateCtorActionModuleOutput)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ActionHostFixtureCopy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
